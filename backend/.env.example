PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=

# Email (Gmail SMTP)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: Google Account > Security > App passwords
# 3. Use port 587 with STARTTLS
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
NODE_ENV=development

# Optional: recipient for `node test-email.js`
TEST_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI assistant (Google Gemini). Keep the key on the server only.
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=
